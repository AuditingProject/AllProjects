pragma solidity 0.8.16;

interface IOndoRateLimiter {
  enum TransactionType {
    SUBSCRIPTION,
    REDEMPTION
  }

  /**
   * @notice Checks and updates the rate limit for a given user and RWA token.
   * @param transactionType The type of transaction (i.e. SUBSCRIPTION or REDEMPTION).
   * @param rwaToken The address of the RWA token being subscribed to/redeemed.
   * @param userID The ID of the user.
   * @param usdValue The value of the transaction in USD with 18 decimals.
   */
  function checkAndUpdateRateLimit(
    TransactionType transactionType,
    address rwaToken,
    bytes32 userID,
    uint256 usdValue
  ) external;
}
